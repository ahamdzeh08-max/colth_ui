    function Window:Notify(config)
        config = config or {}

        local toast = create("Frame", {
            Size = UDim2.fromOffset(260, 67),
            BackgroundColor3 = theme.Card,
            BorderSizePixel = 0
        }, notificationHolder)

        corner(toast, 9)

        local heading = create("TextLabel", {
            Position = UDim2.fromOffset(12, 7),
            Size = UDim2.new(1, -20, 0, 20),
            BackgroundTransparency = 1,
            Text = config.Title or "Notification",
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left
        }, toast)

        local body = create("TextLabel", {
            Position = UDim2.fromOffset(12, 29),
            Size = UDim2.new(1, -20, 0, 29),
            BackgroundTransparency = 1,
            Text = config.Content or "",
            TextSize = 10,
            TextWrapped = true,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top
        }, toast)

        paint(heading, "TextColor3", "Text")
        paint(body, "TextColor3", "Muted")

        local duration = math.max(
            tonumber(config.Duration) or 3,
            0.5
        )

        task.delay(duration, function()
            if toast.Parent then
                TweenService:Create(
                    toast,
                    TweenInfo.new(0.2),
                    {BackgroundTransparency = 1}
                ):Play()

                task.wait(0.22)

                if toast.Parent then
                    toast:Destroy()
                end
            end
        end)

        return toast
    end

    -- WINDOW DRAGGING

    local dragging = false
    local dragStart
    local startPosition

    bind(header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = root.Position
        end
    end)

    bind(UIS.InputChanged, function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart

            root.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    bind(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- CLOSE BUTTON

    bind(close.Activated, function()
        Window:Destroy()
    end)

    -- THEME API

    function Window:SetTheme(newTheme)
        theme = resolveTheme(newTheme)

        for _, entry in ipairs(themeRefs) do
            if entry.Object.Parent then
                entry.Object[entry.Property] = theme[entry.Key]
            end
        end

        for _, info in ipairs(tabs) do
            info.Button.BackgroundColor3 =
                info == activeTab and theme.Accent or theme.Panel
        end
    end

    -- TITLE API

    function Window:SetTitle(newTitle)
        title.Text = tostring(newTitle)
    end

    function Window:SetSubtitle(newSubtitle)
        subtitle.Text = tostring(newSubtitle)
    end

    -- WINDOW SIZE API

    function Window:SetSize(width, height)
        root.Size = UDim2.fromOffset(
            math.max(320, tonumber(width) or 640),
            math.max(250, tonumber(height) or 440)
        )

        updateScale()
    end

    -- DESTROY API

    function Window:Destroy()
        if destroyed then
            return
        end

        destroyed = true

        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end

        screen:Destroy()
    end

    return Window
end

return UI
