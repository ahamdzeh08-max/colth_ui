    local scale = create("UIScale", {
        Scale = 1
    }, root)

    local camera = workspace.CurrentCamera

    local function updateScale()
        if not camera then
            return
        end

        local viewport = camera.ViewportSize
        local widthScale = (viewport.X - 20) / 640
        local heightScale = (viewport.Y - 30) / 440

        scale.Scale = math.max(
            0.45,
            math.min(1, widthScale, heightScale)
        )
    end

    updateScale()

    if camera then
        bind(camera:GetPropertyChangedSignal("ViewportSize"), updateScale)
