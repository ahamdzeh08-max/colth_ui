local function create(class, properties, parent)
    local obj = Instance.new(class)

    for property, value in pairs(properties or {}) do
        obj[property] = value
    end

    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, parent)
end

local function safeCall(callback, ...)
    if type(callback) == "function" then
        local args = table.pack(...)
        local ok, err = pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)

        if not ok then
            warn("[UAER_UI] " .. tostring(err))
        end
    end
end

local function resolveTheme(input)
    local result = table.clone(Themes.Midnight)

    if type(input) == "string" and Themes[input] then
        for key, value in pairs(Themes[input]) do
            result[key] = value
        end
    elseif type(input) == "table" then
        for key, value in pairs(input) do
            result[key] = value
        end
    end

    return result
end

