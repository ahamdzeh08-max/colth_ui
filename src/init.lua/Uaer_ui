        function Tab:CreateSlider(config)
            config = config or {}

            local minimum = tonumber(config.Min) or 0
            local maximum = tonumber(config.Max) or 100
            local increment = math.max(tonumber(config.Increment) or 1, 0.0001)

            assert(maximum > minimum, "Slider Max must be greater than Min")

            local card = makeCard(67)

            local text = create("TextLabel", {
                Position = UDim2.fromOffset(13, 5),
                Size = UDim2.new(1, -95, 0, 20),
                BackgroundTransparency = 1,
                Text = config.Name or "Slider",
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left
            }, card)

            paint(text, "TextColor3", "Text")

            local valueLabel = create("TextLabel", {
                Position = UDim2.new(1, -83, 0, 5),
                Size = UDim2.fromOffset(68, 20),
                BackgroundTransparency = 1,
                TextSize = 11,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Right
            }, card)

            paint(valueLabel, "TextColor3", "Muted")

            local track = create("TextButton", {
                Position = UDim2.fromOffset(14, 42),
                Size = UDim2.new(1, -28, 0, 6),
                BackgroundColor3 = theme.Border,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, card)

            corner(track, 5)

            local fill = create("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0
            }, track)

            corner(fill, 5)

            local value = minimum
            local dragging = false

            local function setValue(newValue, fireCallback)
                newValue = math.clamp(
                    tonumber(newValue) or minimum,
                    minimum,
                    maximum
                )

                value = minimum + math.floor(
                    (newValue - minimum) / increment + 0.5
                ) * increment

                value = math.clamp(value, minimum, maximum)

                local alpha = (value - minimum) / (maximum - minimum)

                fill.Size = UDim2.new(alpha, 0, 1, 0)
                valueLabel.Text = tostring(value)

                if fireCallback ~= false then
                    safeCall(config.Callback, value)
                end
            end

            local function updateFromX(x)
                local alpha = math.clamp(
                    (x - track.AbsolutePosition.X) /
                    math.max(track.AbsoluteSize.X, 1),
                    0, 1
                )

                setValue(minimum + (maximum - minimum) * alpha, true)
            end

            bind(track.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end)

            bind(UIS.InputChanged, function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    updateFromX(input.Position.X)
                end
            end)

            bind(UIS.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            setValue(config.Default or minimum, false)

            return {
                SetValue = function(_, v)
                    setValue(v, true)
                end,
                GetValue = function()
                    return value
                end
            }
        end

